ENV=development
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=suppai_vendor
MONGO_TRANSACTIONS=true

# Use long random values (openssl rand -hex 32)
JWT_SECRET=change-me
MEMBER_JWT_SECRET=same-secret-the-main-suppai-app-signs-member-tokens-with
LINK_SIGNING_SECRET=change-me
EXPOSE_INVITE_LINKS=true

PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=https://suppai.in
CORS_ORIGINS=["https://suppai.in","http://localhost:3000"]

FILE_STORE=gridfs
SEARCH_MODE=text

DEFAULT_COMMISSION_PCT=15
PAYMENT_PENDING_TTL_MINUTES=30

# Leave key id/secret empty to run Razorpay in mock mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SuppAI <no-reply@suppai.in>

RUN_BACKGROUND_JOBS=true
BACKGROUND_JOB_INTERVAL_SECONDS=300
